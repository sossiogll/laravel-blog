# Production settings for docker-compose.yml: copy to .env and fill in the empty values.
# The compose file fixes the rest (APP_ENV, DB_HOST, REDIS_HOST, the cache/session/queue drivers).

# Which image to run. GLLHUB_VERSION is a release (1.2.3) or latest.
# GLLHUB_IMAGES=ghcr.io/sossiogll
# GLLHUB_VERSION=latest
# GLLHUB_PORT=8080

# docker run --rm ghcr.io/sossiogll/gllhub php artisan key:generate --show
APP_KEY=
APP_NAME=gllHub
# The public URL, with https:// when a reverse proxy terminates TLS in front of port 8080.
APP_URL=

# Addresses of that reverse proxy so the application trusts X-Forwarded-*: "*" or a comma-separated list.
TRUSTED_PROXIES=

DB_DATABASE=gllhub
DB_USERNAME=gllhub
DB_PASSWORD=
DB_ROOT_PASSWORD=

LOG_CHANNEL=stderr
LOG_LEVEL=warning

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"
