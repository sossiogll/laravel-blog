.fi-btn {
    /* `align-middle` keeps the button's placement in inline flow independent of its internal baseline, which shifts when the loading indicator is the first grid item. */
    @apply relative inline-grid grid-flow-col items-center justify-center gap-1.5 rounded-lg px-3 py-2 align-middle text-sm font-medium transition duration-75 outline-none;

    &.fi-force-enabled,
    &:not(.fi-disabled):not([disabled]) {
        @apply focus-visible:ring-2;
    }

    &[aria-pressed]:focus-visible:not([disabled]) {
        @apply z-1 ring-2 ring-gray-950/10 dark:ring-white/20;
    }

    &.fi-disabled:not(.fi-force-enabled),
    &[disabled]:not(.fi-force-enabled) {
        @apply cursor-default opacity-70;

        &:not([x-tooltip]) {
            @apply pointer-events-none;
        }
    }

    & > .fi-icon {
        @apply text-gray-400 transition duration-75 dark:text-gray-500;
    }

    &.fi-size-xs {
        @apply gap-1 px-2 py-1.5 text-xs;
    }

    &.fi-size-sm {
        @apply gap-1 px-2.5 py-1.5 text-sm;
    }

    &.fi-size-lg {
        @apply gap-1.5 px-3.5 py-2.5 text-sm;
    }

    &.fi-size-xl {
        @apply gap-1.5 px-4 py-3 text-sm;
    }

    &.fi-outlined {
        @apply text-gray-950 shadow-sm ring-1 ring-gray-300 dark:text-white dark:ring-gray-700;

        &.fi-force-enabled,
